set_property IOSTANDARD LVCMOS18 [get_ports {DI8[6]}]
set_property PACKAGE_PIN U24 [get_ports {DI8[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {DI8[7]}]
set_property PACKAGE_PIN U25 [get_ports {DI8[8]}]
set_property IOSTANDARD LVCMOS18 [get_ports {DI8[8]}]
set_property PACKAGE_PIN AA20 [get_ports {DI4[12]}]
set_property IOSTANDARD LVCMOS18 [get_ports {DI4[12]}]
set_property PACKAGE_PIN AC24 [get_ports {DI6[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {DI6[7]}]
set_property PACKAGE_PIN F23 [get_ports EVNT]
set_property IOSTANDARD LVCMOS33 [get_ports EVNT]
set_property DRIVE 4 [get_ports EVNT]
set_property PULLDOWN TRUE [get_ports EVNT]
set_false_path -from [get_ports {DI* STR*}]
set_property DIFF_TERM TRUE [get_ports MCLK1_P]

set_property PACKAGE_PIN H22 [get_ports I2C_SDA]
set_property IOSTANDARD LVCMOS33 [get_ports I2C_SDA]
set_property PACKAGE_PIN H21 [get_ports I2C_SCL]
set_property IOSTANDARD LVCMOS33 [get_ports I2C_SCL]
set_property PACKAGE_PIN B26 [get_ports I2C_RESET_N]
set_property IOSTANDARD LVCMOS33 [get_ports I2C_RESET_N]
set_property PULLUP TRUE [get_ports I2C_RESET_N]
set_property PACKAGE_PIN F22 [get_ports SCK]
set_property IOSTANDARD LVCMOS33 [get_ports SCK]
set_property PACKAGE_PIN G25 [get_ports MOSI]
set_property IOSTANDARD LVCMOS33 [get_ports MOSI]
set_property PACKAGE_PIN G24 [get_ports MISO]
set_property IOSTANDARD LVCMOS33 [get_ports MISO]
set_property PACKAGE_PIN E26 [get_ports CS]
set_property IOSTANDARD LVCMOS33 [get_ports CS]
set_property PULLUP TRUE [get_ports CS]
create_clock -name mcu_spi -period 250.000 [get_ports SCK]
set_false_path -from [get_ports {MOSI CS}]
set_false_path -to [get_ports MISO]
