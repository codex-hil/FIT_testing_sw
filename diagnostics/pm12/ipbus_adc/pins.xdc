set_property PACKAGE_PIN AA3 [get_ports MCLK1_P]
set_property PACKAGE_PIN AA2 [get_ports MCLK1_N]
set_property IOSTANDARD LVDS [get_ports {MCLK1_P MCLK1_N}]
set_property PACKAGE_PIN H6 [get_ports MGTCLK_P]
set_property PACKAGE_PIN H5 [get_ports MGTCLK_N]
