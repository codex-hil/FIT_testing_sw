+ mem[0x620]=0xbf;mem[0x624]=0xbc;mem[0x628]=64;
+ mem[0x664]=3;mem[0x644]=7;mem[0x6a4]=0xf0;mem[0x8c0]=0xd5;temp_stream=0x00c30000;
