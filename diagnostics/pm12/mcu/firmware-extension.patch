diff --git a/development/src/hw_commands.c b/development/src/hw_commands.c
new file mode 100644
index 0000000..37cd141
--- /dev/null
+++ b/development/src/hw_commands.c
@@ -0,0 +1,106 @@
+#include "extension.h"
+#include "hw_diag.h"
+static const PM_FLASH char earg[]="ERR ARGUMENTS\r\n";
+static const PM_FLASH char off[]="ERR POWER\r\n",busy[]="ERR BUSY\r\n",timeout[]="ERR TIMEOUT\r\n";
+static const PM_FLASH char config_error[]="ERR CONFIG OWNERSHIP\r\n";
+static void hex(uint32_t v,uint8_t digits) { while(digits){uint8_t n=(v>>(--digits*4))&15;pm_console_putc(n<10?'0'+n:'A'+n-10);} }
+static void line(void){pm_console_putc('\r');pm_console_putc('\n');}
+static uint8_t result(uint8_t s){if(s==PM_DIAG_OK)return 1;pm_console_write(s==PM_DIAG_POWER?off:s==PM_DIAG_BUSY?busy:s==PM_DIAG_TIMEOUT?timeout:s==PM_DIAG_CONFIG?config_error:earg);return 0;}
+void pm_command_hw(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}
+ uint8_t saved=pm_irq_enter();uint8_t ports[6],state[12];
+ for(uint8_t n=0;n<6;++n)ports[n]=pm_read8(0x608u+n*32u);
+ for(uint8_t n=0;n<12;++n)state[n]=pm_read8(0x2157u+n);
+ pm_irq_leave(saved);
+ static const PM_FLASH char banner[]="HW V2 PORTS A..F=";pm_console_write(banner);
+ for(uint8_t n=0;n<6;++n)hex(ports[n],2);
+ static const PM_FLASH char label[]=" STATE 2157..2162=";pm_console_write(label);
+ for(uint8_t n=0;n<12;++n)hex(state[n],2);
+ line();
+}
+void pm_command_temp(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}
+ static const PM_FLASH char label[]="ADT7311 REG=";
+ for(uint8_t reg=0;reg<4;++reg){uint16_t v=0;if(!result(pm_diag_temp(reg,&v)))return;pm_console_write(label);hex(reg,2);pm_console_putc(' ');hex(v,reg==2?4:2);line();}
+}
+void pm_command_tdc(const char *args)
+{
+ /* Chip decimal 0..2, followed by exactly two uppercase hex address digits. */
+ if(args[0]<'0'||args[0]>'2'||args[1]!=' '||!args[2]||!args[3]||args[4]){pm_console_write(earg);return;}
+ uint8_t address=0;
+ for(uint8_t n=2;n<4;++n){uint8_t c=args[n],v;if(c>='0'&&c<='9')v=c-'0';else if(c>='A'&&c<='F')v=c-'A'+10;else{pm_console_write(earg);return;}address=(address<<4)|v;}
+ uint16_t v=0;if(!result(pm_diag_tdc(args[0]-'0',address,&v)))return;
+ static const PM_FLASH char label[]="THS788 ";pm_console_write(label);pm_console_putc(args[0]);pm_console_putc(' ');hex(address,2);pm_console_putc(' ');hex(v,4);line();
+}
+void pm_command_pll(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}uint32_t v=0;if(!result(pm_diag_pll(&v)))return;
+ static const PM_FLASH char label[]="CDCE62005 ";pm_console_write(label);hex(v,8);line();
+}
+
+void pm_command_pgtime(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}
+ uint8_t irq=pm_irq_enter();
+ uint8_t state=pm_read8(0x0a2a),overflow=pm_read8(0x0a2b);
+ uint16_t ticks=pm_read8(0x0a28);ticks|=(uint16_t)pm_read8(0x0a29)<<8;
+ if(state==1){ticks=pm_read8(0x0a20);ticks|=(uint16_t)pm_read8(0x0a21)<<8;}
+ pm_irq_leave(irq);
+ static const PM_FLASH char label[]="PGTIME STATE=";pm_console_write(label);hex(state,2);
+ static const PM_FLASH char t[]=" TICKS=";pm_console_write(t);hex(ticks,4);
+ static const PM_FLASH char o[]=" OVF=";pm_console_write(o);hex(overflow,2);
+ static const PM_FLASH char u[]=" US_NOMINAL=";pm_console_write(u);hex((uint32_t)ticks*32u,8);line();
+}
+
+void pm_command_fpga(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}
+ static const PM_FLASH char label[]="FPGA REG=";
+ for(uint8_t a=0x40;a<=0x44;++a){uint16_t v=0;if(!result(pm_diag_fpga(0,a,&v)))return;pm_console_write(label);hex(a,2);pm_console_putc(' ');hex(v,4);line();}
+}
+void pm_command_fpgatest(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}
+ uint16_t v=0,original=0;
+ if(!result(pm_diag_fpga(0,0x41,&v)))return;
+ if(v!=0x504d)goto wrong_image;
+ if(!result(pm_diag_fpga(0,0x42,&v)))return;
+ if(v!=0x5350)goto wrong_image;
+ if(!result(pm_diag_fpga(0,0x40,&original)))return;
+ uint8_t failure=0;
+ for(uint8_t n=0;n<32;++n){uint16_t pattern=(uint16_t)1<<(n&15);if(n>=16)pattern=(uint16_t)~pattern;v=pattern;
+  uint8_t status=pm_diag_fpga(1,0x40,&v);if(!status)status=pm_diag_fpga(0,0x40,&v);
+  if(status || v!=pattern){failure=1;break;}}
+ v=original;if(pm_diag_fpga(1,0x40,&v) || pm_diag_fpga(0,0x40,&v) || v!=original)failure=1;
+ {static const PM_FLASH char good[]="FPGA TEST PASS 32 RESTORED\r\n",bad[]="ERR FPGA TEST OR RESTORE\r\n";pm_console_write(failure?bad:good);}return;
+wrong_image:
+ {static const PM_FLASH char message[]="ERR FPGA IMAGE\r\n";pm_console_write(message);}
+}
+void pm_command_cfg(const char *args)
+{
+ if(!args[0]){uint8_t irq=pm_irq_enter(),in=pm_read8(0x668),out=pm_read8(0x664);pm_irq_leave(irq);
+  static const PM_FLASH char message[]="CFG PORTD IN=";pm_console_write(message);hex(in,2);pm_console_putc(' ');hex(out,2);line();return;}
+ if(args[0]=='H'&&args[1]=='O'&&args[2]=='L'&&args[3]=='D'&&!args[4]){if(result(pm_diag_config(1))){static const PM_FLASH char message[]="CFG HELD FPGA SRAM LOST\r\n";pm_console_write(message);}return;}
+ if(args[0]=='B'&&args[1]=='O'&&args[2]=='O'&&args[3]=='T'&&!args[4]){if(result(pm_diag_config(0))){static const PM_FLASH char message[]="CFG BOOT REQUESTED CHECK INIT DONE\r\n";pm_console_write(message);}return;}
+ pm_console_write(earg);
+}
+void pm_command_flashid(const char *args)
+{
+ if(*args){pm_console_write(earg);return;}uint8_t data[3];if(!result(pm_diag_flash(1,0,data,3)))return;
+ static const PM_FLASH char message[]="FLASH JEDEC=";pm_console_write(message);for(uint8_t n=0;n<3;++n)hex(data[n],2);line();
+}
+void pm_command_flashread(const char *args)
+{
+ uint32_t address=0;uint8_t count=0,data[16];
+ for(uint8_t n=0;n<9;++n){uint8_t c=args[n],v;
+  if(n==6){if(c!=' ')goto invalid;continue;}
+  if(c>='0'&&c<='9')v=c-'0';else if(c>='A'&&c<='F')v=c-'A'+10;else goto invalid;
+  if(n<6)address=(address<<4)|v;else count=(count<<4)|v;
+ }
+ if(args[9] || !count || count>16)goto invalid;
+ if(!result(pm_diag_flash(0,address,data,count)))return;
+ {static const PM_FLASH char message[]="FLASH DATA=";pm_console_write(message);for(uint8_t n=0;n<count;++n)hex(data[n],2);line();}return;
+invalid:pm_console_write(earg);
+}
diff --git a/development/src/hw_diag.h b/development/src/hw_diag.h
new file mode 100644
index 0000000..091d439
--- /dev/null
+++ b/development/src/hw_diag.h
@@ -0,0 +1,23 @@
+#ifndef PM_HW_DIAG_H
+#define PM_HW_DIAG_H
+#include <stdint.h>
+enum pm_diag_result { PM_DIAG_OK, PM_DIAG_POWER, PM_DIAG_BUSY, PM_DIAG_TIMEOUT, PM_DIAG_ARGUMENT, PM_DIAG_CONFIG };
+uint8_t pm_diag_temp(uint8_t reg,uint16_t *value);
+uint8_t pm_diag_tdc(uint8_t chip,uint8_t reg,uint16_t *value);
+uint8_t pm_diag_pll(uint32_t *value);
+uint8_t pm_diag_fpga(uint8_t write,uint8_t address,uint16_t *word);
+uint8_t pm_diag_config(uint8_t hold);
+uint8_t pm_diag_flash(uint8_t id,uint32_t address,uint8_t *data,uint8_t count);
+#ifdef __AVR__
+#include <avr/io.h>
+static inline uint8_t pm_read8(uint16_t a) { return *(volatile uint8_t *)a; }
+static inline void pm_write8(uint16_t a,uint8_t v) { *(volatile uint8_t *)a=v; }
+static inline uint8_t pm_irq_enter(void) { uint8_t s=SREG;asm volatile("cli" ::: "memory");return s; }
+static inline void pm_irq_leave(uint8_t s) { asm volatile("" ::: "memory");SREG=s; }
+#else
+uint8_t pm_read8(uint16_t a);
+void pm_write8(uint16_t a,uint8_t v);
+uint8_t pm_irq_enter(void);
+void pm_irq_leave(uint8_t s);
+#endif
+#endif
diff --git a/development/src/hw_drivers.c b/development/src/hw_drivers.c
new file mode 100644
index 0000000..81b6e09
--- /dev/null
+++ b/development/src/hw_drivers.c
@@ -0,0 +1,134 @@
+/* Main-loop diagnostics. Config commands explicitly reset the FPGA and transfer
+ * config-bus ownership. No DAC, PSU, EEPROM, flash-content or I2C writes. IRQ masking serializes against the recovered PLL ISR;
+ * each transaction is finite, with at most 128 SPI polls per byte. Hardware
+ * interrupt latency and electrical ownership still need validation. */
+#include "hw_diag.h"
+#define A 0x600u
+#define B 0x620u
+#define C 0x640u
+#define E 0x680u
+#define F 0x6a0u
+#define PM_SPIC 0x8c0u
+#define DIR 0u
+#define DIRSET 1u
+#define DIRCLR 2u
+#define OUT 4u
+#define SET 5u
+#define CLR 6u
+#define IN 8u
+static uint8_t powered(void) { return (pm_read8(E+OUT)&4) && (pm_read8(E+IN)&10)==10; }
+static void restore_bits(uint16_t port,uint8_t mask,uint8_t out)
+{ pm_write8(port+CLR,mask & (uint8_t)~out);pm_write8(port+SET,mask & out); }
+static uint8_t temp_byte(uint8_t tx)
+{
+ uint8_t rx=0;
+ for(uint8_t n=0;n<8;++n) {
+  pm_write8(A+CLR,2);pm_write8(A+((tx&128)?SET:CLR),8);
+  pm_write8(A+SET,2);rx=(uint8_t)((rx<<1)|((pm_read8(A+IN)>>2)&1));tx<<=1;
+ }
+ return rx;
+}
+uint8_t pm_diag_temp(uint8_t reg,uint16_t *value)
+{
+ if(reg>3)return PM_DIAG_ARGUMENT;
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK;
+ uint8_t old=pm_read8(A+OUT);
+ if(!powered())result=PM_DIAG_POWER;
+ else if((pm_read8(A+DIR)&0x1a)!=0x1a || !(old&16))result=PM_DIAG_BUSY;
+ else {
+  pm_write8(A+CLR,16);(void)temp_byte((uint8_t)(0x40|(reg<<3)));
+  uint16_t v=temp_byte(0);if(reg==2)v=(uint16_t)((v<<8)|temp_byte(0));
+  pm_write8(A+SET,16);restore_bits(A,0x1a,old);*value=v;
+ }
+ pm_irq_leave(irq);return result;
+}
+static void clock_tdc(void) { pm_write8(B+SET,1);pm_write8(B+CLR,1); }
+static void send_tdc_bit(uint8_t bit) { pm_write8(B+(bit?SET:CLR),2);clock_tdc(); }
+uint8_t pm_diag_tdc(uint8_t chip,uint8_t reg,uint16_t *value)
+{
+ if(chip>2)return PM_DIAG_ARGUMENT;
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK;
+ uint8_t old=pm_read8(B+OUT),dir=pm_read8(B+DIR),select=(uint8_t)(4u<<chip);
+ if(!powered() || !(old&32) || !(pm_read8(B+IN)&64))result=PM_DIAG_POWER;
+ else if((old&0x1c)!=0x1c || (dir&0x1f)!=0x1f)result=PM_DIAG_BUSY;
+ else {
+  pm_write8(B+CLR,select);send_tdc_bit(1);send_tdc_bit(0);
+  for(uint8_t n=0;n<8;++n){send_tdc_bit(reg&128);reg<<=1;}
+  pm_write8(B+DIRCLR,2);clock_tdc();uint16_t v=0;
+  for(uint8_t n=0;n<16;++n){pm_write8(B+SET,1);v=(uint16_t)((v<<1)|((pm_read8(B+IN)>>1)&1));pm_write8(B+CLR,1);}
+  pm_write8(B+SET,select);pm_write8(B+DIRSET,2);clock_tdc();clock_tdc();
+  restore_bits(B,0x1f,old);*value=v;
+ }
+ pm_irq_leave(irq);return result;
+}
+static uint8_t spi_at(uint16_t base,uint8_t tx,uint8_t *rx)
+{
+ pm_write8(base+3,tx);
+ for(uint8_t n=0;n<128;++n)if(pm_read8(base+2)&128){*rx=pm_read8(base+3);return PM_DIAG_OK;}
+ return PM_DIAG_TIMEOUT;
+}
+static uint8_t spi_byte(uint8_t tx,uint8_t *rx){return spi_at(PM_SPIC,tx,rx);}
+uint8_t pm_diag_pll(uint32_t *value)
+{
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK,old=pm_read8(PM_SPIC),out=pm_read8(F+OUT),rx=0;
+ if(!powered())result=PM_DIAG_POWER;
+ else if(!(out&16) || (pm_read8(C+OUT)&7)!=7 || !(old&0x40) || !(pm_read8(0x664)&1))result=PM_DIAG_BUSY;
+ else {
+  /* Same 0x8e readback request as recovered FUN_code_001267. No PLL profile writes. */
+  pm_write8(PM_SPIC,0xf1);pm_write8(F+CLR,16);
+  for(uint8_t n=0;n<4 && result==PM_DIAG_OK;++n)result=spi_byte(n?0:0x8e,&rx);
+  pm_write8(F+SET,16);
+  uint32_t v=0;
+  if(result==PM_DIAG_OK){pm_write8(F+CLR,16);for(uint8_t n=0;n<4 && result==PM_DIAG_OK;++n){result=spi_byte(0,&rx);v|=(uint32_t)rx<<(n*8);}}
+  pm_write8(F+SET,16);pm_write8(PM_SPIC,old);
+  if(result==PM_DIAG_OK)*value=v;
+ }
+ pm_irq_leave(irq);return result;
+}
+
+uint8_t pm_diag_fpga(uint8_t write,uint8_t address,uint16_t *word)
+{
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK;
+ uint8_t old=pm_read8(PM_SPIC),rx=0,high=0;
+ if(!powered() || !(pm_read8(0x668)&8) || !(pm_read8(0x664)&2))result=PM_DIAG_POWER;
+ else if(!(pm_read8(0x664)&1) || !(pm_read8(F+OUT)&16) || (pm_read8(C+OUT)&7)!=7)result=PM_DIAG_BUSY;
+ else {
+  pm_write8(PM_SPIC,0xd1);pm_write8(0x666,1);
+  result=spi_byte((address>>2)|(write?0:0x80),&rx);
+  if(!result)result=spi_byte((uint8_t)(address<<6),&rx);
+  if(!result)result=spi_byte(write?(*word>>8):0,&high);
+  if(!result)result=spi_byte(write?(uint8_t)*word:0,&rx);
+  pm_write8(0x665,1);pm_write8(PM_SPIC,old);
+  if(!result && !write)*word=((uint16_t)high<<8)|rx;
+ }
+ pm_irq_leave(irq);return result;
+}
+uint8_t pm_diag_config(uint8_t hold)
+{
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK;
+ if(!powered())result=PM_DIAG_POWER;
+ else if(!(pm_read8(0x660)&2))result=PM_DIAG_CONFIG;
+ else if(hold){
+  /* Original flash interface: PROGRAM_B LOW, CS HIGH, MCU SPIE owns the bus. */
+  pm_write8(0xac0,0);pm_write8(0x666,2);pm_write8(E+SET,16);
+  pm_write8(E+DIRSET,0xb0);pm_write8(0xac0,0x50);
+ }else{
+  /* Release config bus before PROGRAM_B. Original IRQ/state machine handles DONE. */
+  pm_write8(E+SET,16);pm_write8(0xac0,0);pm_write8(E+DIRCLR,0xb0);pm_write8(0x665,2);
+ }
+ pm_irq_leave(irq);return result;
+}
+uint8_t pm_diag_flash(uint8_t id,uint32_t address,uint8_t *data,uint8_t count)
+{
+ if(!count || count>16 || address>0xffffffUL || address+count>0x1000000UL)return PM_DIAG_ARGUMENT;
+ uint8_t irq=pm_irq_enter(),result=PM_DIAG_OK,rx=0;
+ if(!powered())result=PM_DIAG_POWER;
+ else if((pm_read8(0x664)&2) || (pm_read8(0x668)&8) || (pm_read8(E+DIR)&0xb0)!=0xb0 || !(pm_read8(0xac0)&0x40) || !(pm_read8(E+OUT)&16))result=PM_DIAG_CONFIG;
+ else {
+  pm_write8(E+CLR,16);result=spi_at(0xac0,id?0x9f:0x03,&rx);
+  if(!id)for(uint8_t n=3;n && !result;--n)result=spi_at(0xac0,(uint8_t)(address>>((n-1)*8)),&rx);
+  for(uint8_t n=0;n<count && !result;++n)result=spi_at(0xac0,0,data+n);
+  pm_write8(E+SET,16);
+ }
+ pm_irq_leave(irq);return result;
+}
